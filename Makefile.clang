# Makefile.clang - macOS / clang build for the CPU programs.
#
# CUDA is not available on current macOS, so cudaqap is not built here. Use
# Makefile.cuda on a machine with an NVIDIA GPU.
#
# Usage:
#   make -f Makefile.clang            # genrandomdata + qap
#   make -f Makefile.clang qap
#   make -f Makefile.clang clean

CXX = clang++

# Darwin needs different feature macros from glibc, so this is not just the
# Linux Makefile with the compiler swapped:
#
#   _GNU_SOURCE      is glibc-specific and does nothing here.
#   _XOPEN_SOURCE    must NOT be defined. On Darwin it selects strict POSIX
#                    and hides the BSD extensions these sources use - notably
#                    getopt_long, which both programs need.
#   _DARWIN_C_SOURCE keeps the full BSD/POSIX surface visible: strtok_r,
#                    getopt_long, lrand48/srand48, clock_gettime/clock_getres.
#
# clock_getres(3) requires macOS 10.12 or later.
CPPFLAGS = -D_DARWIN_C_SOURCE
CXXFLAGS = -O3 -std=c++17 -Wall -Wextra -Wpedantic

# Uncomment for a universal binary on Apple silicon plus Intel:
# CXXFLAGS += -arch arm64 -arch x86_64

PROGRAMS = genrandomdata qap

all: $(PROGRAMS)

qap: qap.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $< -o $@

genrandomdata: genrandomdata.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $< -o $@

.PHONY: all clean

clean:
	rm -f qap genrandomdata
